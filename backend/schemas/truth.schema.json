{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "truth.schema.json",
  "title": "private/truth.json (grader only)",
  "description": "The canonical answer. Never reachable through tools. Issues are sorted by (type, affected_ids, issue_id).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "base_currency", "tolerance_minor", "issues"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/semver" },
    "episode_id": { "$ref": "common.schema.json#/$defs/id" },
    "base_currency": { "$ref": "common.schema.json#/$defs/currency" },
    "tolerance_minor": { "type": "integer", "minimum": 0, "maximum": 10 },
    "issues": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/issue" } }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "type",
        "variant",
        "scenario",
        "affected_ids",
        "expected_amount_minor",
        "currency",
        "evidence_sets"
      ],
      "properties": {
        "issue_id": { "$ref": "common.schema.json#/$defs/id" },
        "type": { "$ref": "common.schema.json#/$defs/issue_type" },
        "variant": {
          "enum": [
            "re_entered",
            "re_entered_later",
            "missing",
            "partial",
            "wrong_date",
            "stale_rate",
            "inverted",
            "next_period",
            "prior_period"
          ]
        },
        "scenario": { "enum": ["fx_partial_boundary", "cutoff_fx", null] },
        "affected_ids": {
          "description": "Canonical business ids, sorted.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "expected_amount_minor": {
          "description": "Absolute misstatement in the functional currency; always above the tolerance.",
          "type": "integer",
          "minimum": 2
        },
        "currency": { "$ref": "common.schema.json#/$defs/currency" },
        "evidence_sets": {
          "description": "Each set alone is sufficient (independently re-derivable from the open records).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": { "$ref": "common.schema.json#/$defs/id" }
          }
        }
      }
    }
  }
}
